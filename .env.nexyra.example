# NEXYRA + ATLAS — configuração final da Sprint 29
# Copie somente as variáveis necessárias para C:\Atlas_OFICIAL\.env.
# Nunca reutilize os tokens abaixo entre funções diferentes.

# -----------------------------------------------------------------
# Atlas -> Nexyra CRM
# -----------------------------------------------------------------
ATLAS_NEXYRA_URL=http://127.0.0.1:8000
# Deve ser IGUAL a ATLAS_INTEGRATION_TOKEN no .env do Nexyra + Atlas.
ATLAS_NEXYRA_TOKEN=
ATLAS_NEXYRA_WORKSPACE_ID=
ATLAS_NEXYRA_ACTOR_USER_ID=
ATLAS_NEXYRA_TIMEOUT=10

# Para inteligência operacional completa, use como ator um gerente/admin
# com atlas.use, analytics.read e as permissões das ações desejadas.

# -----------------------------------------------------------------
# Nexyra -> Atlas — Copilot Bridge local
# -----------------------------------------------------------------
ATLAS_COPILOT_ENABLED=1
ATLAS_COPILOT_HOST=127.0.0.1
# 8766 é reservado ao Copilot Nexyra. A API normal do Atlas permanece 8765.
ATLAS_COPILOT_PORT=8766
# Deve ser IGUAL a ATLAS_COPILOT_TOKEN no .env do Nexyra + Atlas.
ATLAS_COPILOT_TOKEN=
ATLAS_COPILOT_TIMEOUT_SECONDS=45
ATLAS_COPILOT_ALLOWED_ORIGIN=http://127.0.0.1:5173
