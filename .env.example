ATLAS_NAME=Atlas
ATLAS_USER=SeuNome
ATLAS_MODEL=atlas
OLLAMA_URL=http://localhost:11434/api/chat

# Embeddings locais usados pela memória semântica (Sprint 18).
ATLAS_EMBEDDINGS=1
ATLAS_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embed
ATLAS_EMBEDDING_TIMEOUT=30
ATLAS_EMBEDDING_CACHE_SIZE=256
ATLAS_MEMORY_SEMANTIC_MIN_SCORE=0.25
ATLAS_MEMORY_SEMANTIC_CANDIDATES=500

# Captura fatos declarados pelo usuário durante a conversa.
ATLAS_AUTO_MEMORY=1
ATLAS_AUTO_MEMORY_MIN_CONFIDENCE=0.75
ATLAS_AUTO_MEMORY_ALLOW_SENSITIVE=0

# Manutenção segura das memórias; o decay reduz prioridade, nunca apaga.
ATLAS_MEMORY_DECAY=1
ATLAS_MEMORY_DECAY_HALF_LIFE_DAYS=365
ATLAS_MEMORY_DECAY_FLOOR=0.20
ATLAS_MEMORY_CONSOLIDATION_THRESHOLD=0.90

ATLAS_MIC=1
ATLAS_VOICE=1
ATLAS_WAKE_WORD=1

# Voz neural brasileira. Use "windows" para forçar a voz local antiga.
ATLAS_TTS_PROVIDER=edge
ATLAS_TTS_VOICE=pt-BR-AntonioNeural
ATLAS_TTS_RATE=+0%
ATLAS_TTS_VOLUME=+0%
ATLAS_TTS_PITCH=+0Hz

# Opcional. Sem esta linha, o Atlas detecta automaticamente a própria pasta.
# ATLAS_PROJECT_DIR=C:\caminho\para\Atlas_OFICIAL
