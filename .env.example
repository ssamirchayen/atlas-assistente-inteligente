ATLAS_NAME=Atlas
ATLAS_USER=SeuNome
ATLAS_MODEL=atlas
OLLAMA_URL=http://localhost:11434/api/chat

# Model Router: mantenha "atlas" até instalar e validar modelos alternativos.
ATLAS_MODEL_LITE=atlas
ATLAS_MODEL_STANDARD=atlas
ATLAS_MODEL_FULL=atlas
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
ATLAS_MODEL_INVENTORY_TIMEOUT=2
# Opcional no modo fonte; o .EXE usa msedge por padrão.
# ATLAS_BROWSER_CHANNEL=msedge

# Embeddings locais usados pela memória semântica (Sprint 18).
ATLAS_EMBEDDINGS=1
ATLAS_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embed
ATLAS_EMBEDDING_TIMEOUT=30
ATLAS_EMBEDDING_CACHE_SIZE=256
ATLAS_MEMORY_SEMANTIC_MIN_SCORE=0.25
ATLAS_MEMORY_SEMANTIC_CANDIDATES=500

# Captura fatos declarados pelo usuário durante a conversa.
ATLAS_AUTO_MEMORY=1
ATLAS_AUTO_MEMORY_MIN_CONFIDENCE=0.75
ATLAS_AUTO_MEMORY_ALLOW_SENSITIVE=0

# Manutenção segura das memórias; o decay reduz prioridade, nunca apaga.
ATLAS_MEMORY_DECAY=1
ATLAS_MEMORY_DECAY_HALF_LIFE_DAYS=365
ATLAS_MEMORY_DECAY_FLOOR=0.20
ATLAS_MEMORY_CONSOLIDATION_THRESHOLD=0.90

ATLAS_MIC=1
ATLAS_VOICE=1
ATLAS_WAKE_WORD=1

# Perfil de latência: balanced (padrão), fast ou accurate.
ATLAS_VOICE_PROFILE=fast

# Voz neural brasileira. Use "windows" para forçar a voz local antiga.
ATLAS_TTS_PROVIDER=edge
ATLAS_TTS_VOICE=pt-BR-AntonioNeural
ATLAS_TTS_RATE=+0%
ATLAS_TTS_VOLUME=+0%
ATLAS_TTS_PITCH=+0Hz

# Voz 2.0: cache local de áudio e blocos menores para iniciar fala mais cedo.
ATLAS_TTS_CACHE=1
ATLAS_TTS_CACHE_MAX_ENTRIES=64
ATLAS_TTS_CHUNK_MAX_CHARS=260

# API local (a exposição em rede permanece desativada por segurança)
ATLAS_API_PORT=8765
ATLAS_API_COMMAND_TIMEOUT=120
# Auditoria local: retenção por tempo e por quantidade de eventos.
ATLAS_API_AUDIT_RETENTION_DAYS=90
ATLAS_API_AUDIT_MAX_EVENTS=10000
# Gere uma chave forte antes de iniciar a API.
# ATLAS_API_KEY=cole_a_chave_administrativa_aqui
# Opcional: chave que pode apenas consultar o status.
# ATLAS_API_READ_KEY=cole_a_chave_de_monitoramento_aqui

# Pesquisa web rastreável (Wikipédia funciona sem chave).
ATLAS_INTERNET_SEARCH=1
ATLAS_INTERNET_SEARCH_TIMEOUT=8
ATLAS_INTERNET_SEARCH_MAX_PER_DOMAIN=2
ATLAS_INTERNET_SEARCH_RATE_LIMIT=30
# Opcional: adiciona resultados do Brave Search.
# ATLAS_BRAVE_SEARCH_API_KEY=cole_a_chave_do_brave_aqui
# Opcional: instância SearXNG própria. Remota deve usar HTTPS.
# ATLAS_SEARXNG_URL=https://busca.suaempresa.com
# ATLAS_SEARXNG_ALLOW_PRIVATE=0

# Piloto escolar + WhatsApp Business Platform oficial.
# Comece sempre em dry-run: nenhuma mensagem real será enviada.
ATLAS_WHATSAPP_DRY_RUN=1
ATLAS_WHATSAPP_GRAPH_API_VERSION=v26.0
ATLAS_WHATSAPP_TIMEOUT=15
ATLAS_WHATSAPP_MAX_BATCH_SIZE=20
ATLAS_WHATSAPP_OPERATIONS_PER_MINUTE=20
# Configure somente no .env local e nunca publique este token.
# ATLAS_WHATSAPP_ACCESS_TOKEN=cole_o_token_do_usuario_de_sistema_meta

# Provisionamento de computadores. Mantenha em dry-run durante homologação.
ATLAS_PROVISIONING_DRY_RUN=1
ATLAS_PROVISIONING_COMMAND_TIMEOUT=900
ATLAS_PROVISIONING_MAX_STEPS=25
# A fila Edge permanece simulada enquanto esta opção for 0.
ATLAS_EDGE_EXECUTION_ENABLED=0
ATLAS_EDGE_MAX_TASKS=50
ATLAS_EDGE_AUDIT_RETENTION_DAYS=90
ATLAS_EDGE_AUDIT_MAX_EVENTS=10000
ATLAS_EDGE_MAX_ONBOARDINGS=200
ATLAS_EDGE_MAX_ACTIVE_ONBOARDINGS=20
# Diretório permitido para criação das pastas corporativas.
# ATLAS_PROVISIONING_WORKSPACE=C:\Atlas_Workspace

# Opcional. Sem esta linha, o Atlas detecta automaticamente a própria pasta.
# ATLAS_PROJECT_DIR=C:\caminho\para\Atlas_OFICIAL

# Voz 2.0 - Etapa 3: fala contínua com prefetch
ATLAS_TTS_PREFETCH=1
ATLAS_TTS_PREFETCH_WORKERS=1
ATLAS_TTS_SENTENCE_PAUSE_MS=90


# Atlas Vision
ATLAS_VISION=1
# ATLAS_VISION_CAPTURE_DIR=C:\Atlas_OFICIAL\data\vision
ATLAS_VISION_KEEP_CAPTURES=0

ATLAS_VISION_MODEL=qwen2.5vl:3b
ATLAS_VISION_TIMEOUT=120
